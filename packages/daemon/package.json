{
  "name": "@debrief/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "debrief": "dist/cli.js",
    "debrief-daemon": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
