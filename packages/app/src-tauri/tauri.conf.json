{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Debrief",
  "version": "0.1.0",
  "identifier": "com.tenten.debrief",
  "build": {
    "beforeDevCommand": "pnpm prepare:daemon-runtime && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm prepare:daemon-runtime && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Debrief",
        "width": 1280,
        "height": 800,
        "minWidth": 944,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../../daemon/runtime-dist/": "debrief-daemon-runtime/"
    },
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
